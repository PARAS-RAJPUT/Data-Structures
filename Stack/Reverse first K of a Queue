class Solution {
  public:
    queue<int> reverseFirstK(queue<int> q, int k) {
        // code here
        
        stack<int> ans;
        // 3 <= 5
        if(k <= q.size()) {
            // 1, 2, 3  // 4, 5
            for(int i = 0; i<k; i++) {
                ans.push(q.front());
                q.pop();
            }
            //size = 2
            // 3, 2, 1
            int size = q.size();
            for(int i = 0; i<k; i++) {
                q.push(ans.top());
                ans.pop();
                //NULL
            }
            
            for(int i = 0; i<size; i++) {
                q.push(q.front());
                q.pop();
                //3, 2, 1, 4, 5
            }
        }
        else{
            return q;
        }
        return q;
    }
};
