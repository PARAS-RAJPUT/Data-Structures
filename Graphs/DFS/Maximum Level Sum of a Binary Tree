class Solution {
public:

    map<int, int> mp;

    void dfs(TreeNode* root, int currLevel) {
        if(!root) {
            return;
        }
        mp[currLevel] += root->val;

        dfs(root->left, currLevel + 1);
        dfs(root->right, currLevel + 1);
    }

    int maxLevelSum(TreeNode* root) {
        
        mp.clear();

        dfs(root, 1);

        int maxSum = INT_MIN;
        int result = 0;

        for(auto &it : mp) {
            int level = it.first;
            int sum = it.second;

            if(sum > maxSum) {
                maxSum = sum;
                result = level;
            }
        }

        return result;
    }
};
