class Solution {
  public:
    void dfs(vector<vector<char>>& grid, int r, int c) {
        int m = grid.size();
        int n = grid[0].size();
        
        if(r < 0 || c < 0 || r >= m || c >= n || grid[r][c] != 'O') {
            return;
        }
        
        grid[r][c] = 'S';
        
        dfs(grid, r, c+1);
        dfs(grid, r, c-1);
        dfs(grid, r+1, c);
        dfs(grid, r-1, c);
        
    }
    void fill(vector<vector<char>>& grid) {
        // Code here
        
        int m = grid.size();
        int n = grid[0].size();
        
        for(int i = 0; i<m; i++) {
            if(grid[i][0] == 'O') {
                dfs(grid, i ,0);
            }
            if(grid[i][n-1] == 'O') {
                dfs(grid, i, n-1);
            }
        }
        
        for(int j = 0; j<n; j++) {
            if(grid[0][j] == 'O') {
                dfs(grid, 0 ,j);
            }
            if(grid[m-1][j] == 'O') {
                dfs(grid, m-1, j);
            }
        }
        
        for(int i = 0; i<m; i++) {
            for(int j = 0; j<n; j++) {
                if(grid[i][j] == 'O') {
                    grid[i][j] = 'X';
                }
                if(grid[i][j] == 'S') {
                    grid[i][j] = 'O';
                }
            }
        }
        
        
    }
};
