class Solution {
public:
    
    void dfs(int u, vector<vector<int>>& adj,
             vector<int>& visited, vector<int>& topo) {

        visited[u] = 1;

        for (int v : adj[u]) {
            if (!visited[v]) {
                dfs(v, adj, visited, topo);
            }
        }

        // push after visiting all neighbours (postorder)
        topo.push_back(u);
    }

    vector<int> topoSort(int V, vector<vector<int>>& edges) {

        // Step 1: build adjacency list from edge list
        vector<vector<int>> adj(V);
        for (auto &e : edges) {
            adj[e[0]].push_back(e[1]);
        }

        // Step 2: DFS on all nodes
        vector<int> visited(V, 0);
        vector<int> topo;

        for (int i = 0; i < V; i++) {
            if (!visited[i]) {
                dfs(i, adj, visited, topo);
            }
        }

        // Step 3: reverse postorder to get topo sort
        reverse(topo.begin(), topo.end());
        return topo;
    }
};
