class Solution {
public:
    bool dfs(int u, vector<bool> &visited, vector<bool> &st, vector<vector<int>> &graph) {
        visited[u] = true;
        st[u] = true;

        for(auto &v : graph[u]) {
            if(!visited[v] && dfs(v, visited, st, graph)) {
                return true;
            }
            else if(st[v]) {
                return true;
            }
        } 
        st[u] = false;
        return false;
    }
    vector<int> eventualSafeNodes(vector<vector<int>>& graph) {
        int n = graph.size();
        vector<int> ans;
        if(n == 0) {
            return ans;
        }

        vector<bool> visited(n+1, false);
        vector<bool> st(n+1, false);

        for(int i = 0; i<n; i++) {
            if(!visited[i]) {
                dfs(i, visited, st, graph);
            }
        }
        for(int i = 0; i<n; i++) {
            if(!st[i]) {
                ans.push_back(i);
            }
        }
        return ans;
    }
};
