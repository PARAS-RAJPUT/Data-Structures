class Solution {
    vector<int> topo;
    bool dfs(int u, vector<vector<int>>& adj, vector<int>&  visited, vector<int>& st) {
        if(!visited[u]) {
            visited[u] = 1;
            st[u] = 1;

            for(int v : adj[u]) {
                if(dfs(v, adj, visited, st)) {
                    return true;
                }
            }
            topo.push_back(u);
            st[u] = 0;
        }
        else if(st[u]) {
            return true;
        }
        return false;
    }
public:
    int largestPathValue(string colors, vector<vector<int>>& edges) {
        int maxcolor = -1;

        vector<vector<int>> adj(colors.size());

        for(auto &vec : edges) {
            int a = vec[0];
            int b = vec[1];
            adj[b].push_back(a);
        }

        vector<int> visited(adj.size());
        vector<int> st(adj.size());

        for(int i = 0; i <adj.size(); i++) {
            if(!visited[i]) {
                if(dfs(i, adj, visited, st)) {
                    return -1;
                }
            }
        }

        vector<vector<int>> dp(adj.size(), vector<int>(26, 0));

        for(int k = topo.size() - 1; k >= 0; k--) {

            int i = topo[k];

            dp[i][colors[i] - 97] += 1;

            maxcolor = max(maxcolor, dp[i][colors[i] - 97]);

            for(int x : adj[i]) {
                for(int col = 0; col<26; col++) {
                    if(dp[x][col] < dp[i][col]) {
                        dp[x][col] = dp[i][col];
                    }
                }
            }
        }
        return maxcolor;
    }
};
