class Solution {
public:
    int maxAbsoluteSum(vector<int>& nums) {
        int maxSum = 0;
        int minSum = 0;
        int ans = 0;

        for(int i = 0; i<nums.size(); i++) {
            maxSum = max(0, maxSum + nums[i]);
            minSum = min(0, minSum + nums[i]);
            ans = max(ans, maxSum - minSum);
        }
        return ans;
    }
};
