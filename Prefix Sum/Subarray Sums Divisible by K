class Solution {
public:
    int subarraysDivByK(vector<int>& nums, int k) {
        vector<int> count(k,0);
        count[0] = 1;
        int sum = 0, ans = 0;

        for(int i = 0; i<nums.size(); i++) {
            sum += nums[i];

            int rem = sum % k;

            if(rem < 0) {
                rem += k;
            }
            ans += count[rem];
            count[rem]++;
        }
        return ans;
    }
};
