class Solution {
public:
    int findMaxForm(vector<string>& strs, int m, int n) {
        vector<vector<int>> dp(m+1, vector<int>(n+1, 0));

        for(auto &s : strs) {
            int zeros = 0, ones = 0;

            for(char ch : s) {
                zeros += (ch == '0');
                ones += (ch == '1');
            }

            for(int i = m; i>=zeros; i--) {
                for(int j = n; j>=ones; j--) {
                    int take = 1 + dp[i - zeros][j - ones];
                    int skip = dp[i][j];
                    dp[i][j] = max(take, skip);
                }
            }
        }
        return dp[m][n];
    }
};
