class Solution {
public:
    long long maxScore(vector<int>& nums1, vector<int>& nums2, int k) {
        int n = nums1.size();
        int m = nums2.size();

        vector<vector<vector<long long>>> dp(n+1, vector<vector<long long>>(m+1, vector<long long>(k+1, LLONG_MIN)));

        for(int i = 0; i<=n; i++) {
            for(int j = 0; j<=m; j++) {
                dp[i][j][0] = 0;
            }
        }

        for(int i = 1; i<=n; i++) {
            for(int j = 1; j<=m; j++) {
                for(int l = 1; l<=k; l++) {
                    long long pick = LLONG_MIN;
                    if(dp[i-1][j-1][l-1] != LLONG_MIN) {
                        pick = dp[i-1][j-1][l-1] +1LL * nums1[i-1] * nums2[j-1];
                    }
                    long long skip_1 = dp[i-1][j][l];
                    long long skip_2 = dp[i][j-1][l];

                    dp[i][j][l] = max({pick, skip_1, skip_2});
                }
            }
        }
        return dp[n][m][k];
    }
};©leetcode
