class Solution {
public:
    int totalHammingDistance(vector<int>& nums) {

        int n = nums.size();
        
        int j = 0;

        int count = 0;

        for(int i = 0; i<n; i++) {
            for(int j = i; j<n; j++) {
                count +=  __builtin_popcount(nums[j] ^ nums[i]);
            }
            j++;
        }

        return count;
    }
};
