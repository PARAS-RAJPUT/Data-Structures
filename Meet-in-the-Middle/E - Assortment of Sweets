#include <bits/stdc++.h>
using namespace std;

int main() 
{
    int n;
    long long s;
    
    cin>>n>>s;
    
    vector<long long> a(n);
    
    
    for(int i = 0; i<n; i++) {
      cin>>a[i];
    }
    
    int mid = n/2;
    
    vector<long long> left, right;
    
    for(int mask = 0; mask < (1 << mid); mask++) {
      long long sum = 0;
      
      for(int i = 0; i<mid; i++) {
        if(mask & (1 << i)) {
          sum += a[i];
        }
      }
      left.push_back(sum);
    }
    
    for(int mask = 0; mask < (1 << (n - mid)); mask++) {
      long long sum = 0;
      
      for(int i = 0; i<n-mid; i++) {
        if(mask & (1 << i)) {
          sum += a[mid+i];
        }
      }
      right.push_back(sum);
    }
    
    sort(right.begin(), right.end());
    
    long long answer = 0;
    
    for(long long x : left) {
      long long need = s - x;
      auto range = equal_range(right.begin(), right.end(), need);
      answer += (range.second - range.first);
      
    }
    
    cout<<answer<<"\n";
    
    
}
