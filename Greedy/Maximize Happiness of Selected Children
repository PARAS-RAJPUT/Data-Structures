class Solution {
public:
    long long maximumHappinessSum(vector<int>& happiness, int k) {

        sort(happiness.begin(), happiness.end(), greater<int>());

        long long totalWays = 0;

        for(int i = 0; i<k; i++) {

            int currWays = happiness[i] - i;
            if(currWays <= 0) {
                break;
            }

            totalWays += currWays;
        }
        return totalWays;
    }
};
