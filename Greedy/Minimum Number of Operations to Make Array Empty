class Solution {
public:
    int minOperations(vector<int>& nums) {
        
        unordered_map<int, int> freq;
 
        for(auto& n : nums) {
            freq[n]++;
        }

        long long result = 0;

        for(auto& f : freq) {

            int value = f.second;

            if(value == 1) {
                return -1;
            }

            if(value % 3 == 0) {
                result += value/3;
            }
            else{
                result += (value/3) + 1;
            }
        }
        return result;
    }
};
