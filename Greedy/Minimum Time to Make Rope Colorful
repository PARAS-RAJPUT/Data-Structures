
//************************ MY APPROACH ******************************

class Solution {
public:
    int minCost(string colors, vector<int>& neededTime) {
        int n = colors.size(), sum = 0;

        for(int i = 1; i<n; i++) {
            int max1 = 0;
            while(i < n && colors[i] == colors[i-1]) {
                sum += neededTime[i-1];
                max1 = max(max1, neededTime[i-1]);
                i++;
            }

            sum += neededTime[i-1];
            max1 = max(max1, neededTime[i-1]);
            if(max1 != 0) {
                sum -= max1;
            }
        }
        return sum;
    }
};

//************************* BEST APPROACH BY GREEDY **********************

class Solution {
public:
    int minCost(string colors, vector<int>& neededTime) {
        int n = colors.size();

        int time = 0;

        int prevMax = 0;

        for(int i = 0; i<n; i++) {
            if(i>0 && colors[i] != colors[i-1]) {
                prevMax = 0;
            }

            int curr = neededTime[i];

            time += min(prevMax, curr);

            prevMax = max(prevMax, curr);
            
        }
        return time;
    }
};
