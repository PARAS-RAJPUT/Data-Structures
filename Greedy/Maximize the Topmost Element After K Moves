class Solution {
public:
    int maximumTop(vector<int>& nums, int k) {
        if(nums.size() == 1 && k%2 != 0) {
            return -1;
        }

        if(nums.size() < k) {
            return *max_element(nums.begin(), nums.end());
        }

        int ans = 0;
        for(int i = 0; i<k-1; i++) {
            ans = max(ans, nums[i]);
        }
        if(k < nums.size()) {
            ans = max(ans, nums[k]);
        }
        return ans;
    }
};
