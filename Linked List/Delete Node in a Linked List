class Solution {
public:
    void deleteNode(ListNode* node) {
        /*node->val=node->next->val;
        ListNode* temp=node->next;
        node->next=node->next->next;
        delete temp; */
        ListNode* prev = NULL;

        while(node && node->next) {
            node->val = node->next->val;
            prev = node;
            node = node->next;
        }        
        delete(node);
        prev->next = NULL;
    }
};
