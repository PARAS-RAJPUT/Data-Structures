class Solution {
public:
    int dominantIndices(vector<int>& nums) {
        int n = nums.size();
        int count = 0;
        long long sum = 0;

        for(int num: nums){
            sum += num;
        }
        for(int i = 0; i<n-1; i++) {
            sum -= nums[i];
            int right_len = n-i-1;
            double right_avg  = (double)sum / right_len;
            if(nums[i] > right_avg) {
                count++;
            }
        }
        return count;
    }
};©leetcode
