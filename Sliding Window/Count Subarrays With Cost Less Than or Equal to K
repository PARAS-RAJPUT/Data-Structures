class Solution {
public:
    long long countSubarrays(vector<int>& nums, long long k) {
        /* int n = nums.size();
        long long count = 0;

        for(int i = 0; i<n; i++) {
            long long  min_j = LLONG_MAX;
            long long  max_j = LLONG_MIN;

            for(int j = i; j<n; j++) {
                min_j = min(min_j, (long long)nums[j]);
                max_j = max(max_j, (long long)nums[j]);
                long long cost = (max_j - min_j) * (j - i + 1);
                if(cost <= k) {
                    count++;
                }
                else{
                    break;
                }
            }
        }
        return count; */

        int n = nums.size();
        long long ans = 0;

        long long j = 0;

        deque<int> mx, mn;

        for(int i = 0; i<n; i++) {
            while(mx.size() && nums[mx.back()] <= nums[i]) {
                mx.pop_back();
            }
            while(mn.size() && nums[mn.back()] >= nums[i]) {
                mn.pop_back();
            }

            mx.push_back(i);
            mn.push_back(i);

            while(j <= i && (nums[mx.front()] - nums[mn.front()]) * (i - j + 1) > k) {
                if(mx.front() == j) {
                    mx.pop_front();
                }
                if(mn.front() == j) {
                    mn.pop_front();
                }
                j++;
            }
            ans += i-j+1;
        }
        return ans;
    }
};
