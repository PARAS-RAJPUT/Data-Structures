class Solution {
public:
    int canBeTypedWords(string text, string brokenLetters) {
        bool mp[26];

        for(char &ch : brokenLetters) {
            mp[ch - 'a'] = true;
        }

        int result = 0;

        bool can = true;

        for(char &ch : text) {
            if(ch == ' ') {
                if(can) {
                    result++;
                }
                can = true;
            }
            else if(mp[ch - 'a'] == true) {
                can = false;
            }
        }
        if(can) {
            result++;
        }

        return result;

    }
};
