class Solution {
public:
    int longestNiceSubarray(vector<int>& nums) {
        int n = nums.size();
        int max_length = 1;
        int l = 0;
        int used_bits = 0;

        for(int r = 0; r<n; r++) {
            while((used_bits & nums[r]) != 0) {
                used_bits ^= nums[l];
                l++;
            }
            used_bits |= nums[r];
            max_length = max(max_length, r-l+1);
        }
        return max_length;
    }
};
