class Solution {
public:
    long long maximumSubarraySum(vector<int>& nums, int k) {
        long long ans = 0;
        long long sum = 0;

        unordered_map<int, int> mp;

        for(int i = 0; i<nums.size(); i++) {
            mp[nums[i]] = i;
            sum += nums[i];

            if(i >= k) {
                sum -= nums[i-k];
                if(mp[nums[i-k]] == i-k) {
                    mp.erase(nums[i-k]);
                }
            }

            if(mp.size() >= k) {
                ans = max(ans, sum);
            }
        }
        return ans;
    }
};
