class Solution {
public:
    int maximumWhiteTiles(vector<vector<int>>& tiles, int carpetLen) {
        sort(tiles.begin(), tiles.end());

        int i = 0;
        int j = 0;
        int ans = 0;
        int cover = 0;
        int n = tiles.size();
        int p;

        for(i = 0; i<n && ans<carpetLen; ) {
            if(tiles[j][0] +  carpetLen > tiles[i][1]) {
                cover += tiles[i][1] - tiles[i][0] + 1;
                ans = max(ans, cover);
                i++;
            }
            else{
                p = max(tiles[j][0] + carpetLen - tiles[i][0], 0);
                ans = max(ans, cover+p);
                cover -= (tiles[j][1] - tiles[j][0] + 1);
                j++;
            }
        }
        return ans;
    }   
};
