int countPrimesLessThan(int limit) {
    if(limit <= 2) {
        return 0;
    }
    
    vector<bool> isPrime(limit, true);
    
    isPrime[0] = isPrime[1] = false;
    
    for(int i = 2; i * i < limit; i++) {
        if(isPrime[i]) {
            for(int j = i * i; j<limit; j += i) {
                isPrime[j] = false;
            }
        }
    }
    int count = 0;
    for(int i = 2; i<limit; i++) {
        if(isPrime[i]) {
            count++;
        }
    }
    return count;
}
