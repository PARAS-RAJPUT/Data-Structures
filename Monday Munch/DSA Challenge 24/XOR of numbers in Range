class Solution {
public:

    int xorUpdate(int n) {
        if(n < 0) {
            return 0;
        }
        
        switch(n % 4) {
            case 0 : return n;
            case 1 : return 1;
            case 2 : return n+1;
            default : return 0;
        }
    }
    int rangeXOR(int L, int R) {
        // write your code here 
        
        return xorUpdate(R) ^ xorUpdate(L-1);
        
    }
};
