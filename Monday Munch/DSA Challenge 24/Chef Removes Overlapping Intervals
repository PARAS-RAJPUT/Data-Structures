class Solution {
public:
    int findMinimumRemovals(vector<vector<int>>& intervalList) {
        // write your code here 
        if(intervalList.empty()) {
            return 0;
        }
        
        sort(intervalList.begin(), intervalList.end(),
        [](const vector<int>&a, const vector<int>&b){
            return a[1] < b[1];
        });
        
        int removals = 0;
        int prevEnd = intervalList[0][1];
        
        
        for(int i = 1; i<intervalList.size(); i++) {
            if(intervalList[i][0] < prevEnd) {
                removals++;
            }
            else{
                prevEnd = intervalList[i][1];
            }
        }
        return removals;
    }
};
