class Solution {
public:
    ListNode* mergeKLists(vector<ListNode*>& lists) {
        // write your code here
        priority_queue<ListNode*, vector<ListNode*>, function<bool(ListNode*, ListNode*)>>pq([](ListNode* a, ListNode* b){
            return a->val > b->val;
        });
        
        
        for(auto node : lists) {
            if(node){
                pq.push(node);
            }
        }
        
        ListNode dummy(0);
        ListNode* tail = &dummy;
        
        
        while(!pq.empty()) {
            ListNode* curr = pq.top();
            pq.pop();
            
            tail->next = curr;
            
            tail = tail -> next;
            
            if(curr->next) {
                pq.push(curr->next);
            }
        }
        
        return dummy.next;
    }
};
