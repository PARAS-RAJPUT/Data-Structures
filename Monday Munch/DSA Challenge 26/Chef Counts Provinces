class Solution {
public:

    void dfs(int city, vector<vector<int>> &connectionMatrix, vector<bool>& visited) {
        visited[city] = true;
        
        int n = connectionMatrix.size();
        for(int next = 0; next < n; next++) {
            if(!visited[next] && connectionMatrix[city][next] == 1) {
                dfs(next, connectionMatrix, visited);
            }
        }
    }
    
    int countProvinces(vector<vector<int>>& connectionMatrix) {
        // write your code here 
        int n = connectionMatrix.size();
        
        vector<bool>visited(n, false);
        
        int provinces = 0;
        
        
        for(int i = 0; i<n; i++) {
            if(!visited[i]) {
                dfs(i, connectionMatrix, visited);
                provinces++;
            }
        }
        
        
        return provinces;
    }
};
