#include <bits/stdc++.h>
using namespace std;

int main() {

    int t;
    cin >> t;
    while (t--) {
        int n;
        cin >> n;

        vector<long long> a(n), b(n);
        for (int i = 0; i < n; i++) cin >> a[i];
        for (int i = 0; i < n; i++) cin >> b[i];

        long long maxPrev = -1;
        bool ok = true;

        for (int i = 0; i < n; i++) {
            if (a[i] > b[i]) {
                ok = false;
                break;
            }
            if (a[i] < b[i] && maxPrev >= a[i]) {
                ok = false;
                break;
            }
            maxPrev = max(maxPrev, a[i]);
        }

        cout << (ok ? "Yes\n" : "No\n");
    }
  
}
