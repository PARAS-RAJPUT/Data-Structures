#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
    int t;
      cin>>t;
      
      while(t--) {
        int n, k;
        cin>>n>>k;
        
        vector<int> a(n);
        
        for(int i = 0; i<n; i++) {
          cin>>a[i];
        }
        
        string s;
        cin>>s;
        
        vector<int> available;
        
        for(int i = 0; i<n; i++) {
          if(s[i] == '0') {
            available.push_back(a[i]);
          }
        }
        
        if((int)available.size() < k) {
          cout<<-1<<"\n";
          continue;
        }
        
        
        sort(available.begin(), available.end());
        
        int cost = 0;
        
        for(int i = 0; i<k; i++) {
          cost += available[i];
        }
        
        cout<<cost<<"\n";
      }
}
