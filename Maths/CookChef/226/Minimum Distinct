
#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
	int T;
    cin >> T;
    while (T--) {
        int N, K;
        cin >> N >> K;

        vector<int> A(N);
        for (int i = 0; i < N; i++) cin >> A[i];

        unordered_map<int,int> freq, first;
        for (int i = 0; i < N; i++) {
            freq[A[i]]++;
            if (!first.count(A[i]))
                first[A[i]] = i;
        }
        
        int keepVal = -1, minIdx = N;
        for (auto &p : first) {
            if (p.second < minIdx) {
                minIdx = p.second;
                keepVal = p.first;
            }
        }

        vector<int> removable;
        for (auto &p : freq) {
            if (p.first != keepVal)
                removable.push_back(p.second);
        }

        sort(removable.begin(), removable.end());

        int removed = 0;
        for (int f : removable) {
            if (K >= f) {
                K -= f;
                removed++;
            } else break;
        }

        int distinct = freq.size();
        cout << distinct - removed << "\n";
    }

}
