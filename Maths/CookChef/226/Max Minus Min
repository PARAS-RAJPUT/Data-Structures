/*

You are given an array AA of NN integers.

You can perform the following operation as many times as you want (possibly 00):

    Choose index ii (1≤i≤N1≤i≤N), and multiply AiAi​ by 22.

Find the minimum possible value of max⁡(A)−min⁡(A)max(A)−min(A) you can achieve through the use of the operations.
Input Format

    The first line of input will contain a single integer TT, denoting the number of test cases.
    Each test case consists of multiple lines of input.
        The first line contains NN - the size of the array.
        The second line contains NN integers - A1,A2,…,ANA1​,A2​,…,AN​.

Output Format

For each test case, output on a new line the minimum possible value of max⁡(A)−min⁡(A)max(A)−min(A) possible with the use of several operations.
Constraints

    1≤T≤1041≤T≤104
    2≤N≤1052≤N≤105
    1≤Ai≤1051≤Ai​≤105
    The sum of NN over all test cases does not exceed 105105.

Sample 1:
Input
Output

3
3
2 3 1
3
1 2 2
5
4 2 3 57 10

1
0
24

Explanation:

Test Case 1 : Choose i=3i=3, and multiply by 22. We get [2,2,3][2,2,3] which has max⁡(A)−min⁡(A)=1max(A)−min(A)=1.

Test Case 2 : Choose i=1i=1, and multiply by 22. We get [2,2,2][2,2,2] which has max⁡(A)−min⁡(A)=0max(A)−min(A)=0.


*/
#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
    int T;
    cin >> T;

    while (T--) {
        int N;
        cin >> N;

        vector<int> A(N);
        for (int i = 0; i < N; i++) cin >> A[i];

        vector<pair<int,int>> values;

        for (int i = 0; i < N; i++) {
            long long x = A[i];
            while (x <= 200000) {
                values.push_back({x, i});
                x *= 2;
            }
        }

        sort(values.begin(), values.end());

        vector<int> freq(N, 0);
        int covered = 0;
        int left = 0;
        int ans = INT_MAX;

        for (int right = 0; right < (int)values.size(); right++) {
            if (freq[values[right].second]++ == 0)
                covered++;

            while (covered == N) {
                ans = min(ans,
                          values[right].first - values[left].first);

                if (--freq[values[left].second] == 0)
                    covered--;

                left++;
            }
        }

        cout << ans << "\n";
    }
}

