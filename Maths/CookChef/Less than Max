#include <bits/stdc++.h>
using namespace std;

int main() {

    int t;
    cin >> t;
    while (t--) {
        int n;
        cin >> n;
        vector<int> a(n);
        for (int i = 0; i < n; i++) {
            cin >> a[i];
        }

        unordered_set<int> un;
        un.insert(1); 

        int ans = 0;

        for (int x : a) {
            if (un.count(x)) {
                ans++;
                un.insert(x + 1);
            }
        }

        cout << ans << "\n";
    }

}
