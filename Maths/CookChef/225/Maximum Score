#include <bits/stdc++.h>
using namespace std;

int main() 
{
    int t;
    cin>>t;
    
    while(t--) {
      int n;
      cin>>n;
      
      vector<int>a(n), b(n);
      
      for(int i = 0; i<n; i++) {
        cin>>a[i];
      }
      for(int i = 0; i<n; i++) {
        cin>>b[i];
      }
      
      if(n==1) {
        cout<<b[0]<<"\n";
        continue;
      }
      
      long long total = 0;
      int minPenalty = INT_MAX;
      
      for(int i = 0; i<n; i++) {
        total += a[i];
        minPenalty = min(minPenalty, a[i] - b[i]);
      }
      
      cout<<total - minPenalty<<"\n";
      
    }
}
