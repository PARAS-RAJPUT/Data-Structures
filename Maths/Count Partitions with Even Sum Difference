class Solution {
public:
    int countPartitions(vector<int>& nums) {
        int n = nums.size();

        int count = 0;

        int totalSum = 0;
        int leftSum = 0;

        for(int i = 0; i<n; i++) {
            totalSum += nums[i];
        }

        for(int i = 0; i<n-1; i++) {

            leftSum += nums[i];
            int rightSum = totalSum - leftSum;

            if((leftSum % 2) == (rightSum % 2)) {
                count++;
            }
        } 
        return count;
    }
};
