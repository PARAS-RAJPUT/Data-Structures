
//************************ T.C = O(N) *************************

class Solution {
public:
    int M = 1e9+7;
    int countPermutations(vector<int>& complexity) {

        int n = complexity.size();
        long long count = 1;

        for(int i = 1; i < n; i++) {
            if(complexity[i] <= complexity[0]) {
                    return 0;
            }
            count = (count * i) % M;
        }

        return count % M;

    }
};
