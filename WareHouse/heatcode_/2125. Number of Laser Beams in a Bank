class Solution {
public:
    int numberOfBeams(vector<string>& bank) {
        int beams = 0, prev = 0;
        for(string& row : bank) {
            int devices = count(row.begin(), row.end(), '1');
            if(devices > 0) {
                beams += prev * devices;
                prev = devices;
            }
        }
        return beams;
    }
};
