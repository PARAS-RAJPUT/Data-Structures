
//----------------------------------MY APPROACH FOR THE QUESTION ------------------------------

class Solution {
public:
    int maxFreqSum(string s) {
        int maxVowel = 0;
        int maxCons = 0;

        int arr[26] = {0};

        for(char &c : s) {
            arr[c - 'a']++;

            if(string("aeiou").find(c) != string :: npos) {
                maxVowel = max(maxVowel, arr[c - 'a']);
            }else{
                maxCons = max(maxCons, arr[c - 'a']);
            }
        }
        return maxCons + maxVowel;
    }
};

