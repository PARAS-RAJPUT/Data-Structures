//*******************************T.C = O(NlogN)***************************************

class Solution {
public:
    int maxFrequencyElements(vector<int>& nums) {
        sort(nums.begin(), nums.end());
        int count = 1;
        int maxf = 1;
        int n =nums.size();
        int result = 0;

        int i = 1;

        for (int i = 1; i < n; i++) {
            if(nums[i] == nums[i-1]) {
                count++;
            }
            else{
                count=1;
            }
            if(count > maxf) {
                maxf = count;
                result = count;
            }
            else if(count == maxf) {
                result += count;
            }
        }
        if (maxf == 1) return n;

        return result;
    }
};
