class Solution {
public:
    vector<int> getSneakyNumbers(vector<int>& nums) {
    
        unordered_map<int, int> count;
        vector<int> result;
        for(int num : nums) {
            count[num]++;
            if(count[num] == 2) {
                result.push_back(num);
            }
        }
        return result;
    }
};
