
//************************ USING MAP(2 PASS) *****************************
//************************ T.C = 0(2*N) **********************************
//************************ S.C = 0(N) ************************************

class Solution {
public:
    const int MOD = 1e9+7;
    int specialTriplets(vector<int>& nums) {
        int n = nums.size();

        unordered_map<long long, long long> right, left;

        for(long long x : nums) {
            right[x]++;
        }

        long long count = 0;

        for(int j = 0; j<n; j++) {

            long long mid = nums[j];

            right[mid]--;
            
            long long target = 2*mid;
            long long leftCount = left[target];
            long long rightCount = right[target];

            count += ((leftCount * rightCount) % MOD) % MOD;

            left[mid]++;
        }
        return count % MOD;
    }
};


//************************ USING MAP(1 PASS) *****************************
//************************ T.C = 0(N) **********************************
//************************ S.C = 0(N) ************************************

class Solution {
public:
    int M = 1e9+7;
    int specialTriplets(vector<int>& nums) {
        unordered_map<int,int> valid_i, valid_j;

        int result = 0;

        for(int &num : nums) {
            if(num % 2 == 0) {
                result = (result + valid_j[num/2]) % M;
            }

            valid_j[num] = (valid_j[num] + valid_i[num*2]) % M;

            valid_i[num]++;
        }
        return result;
    }
};
