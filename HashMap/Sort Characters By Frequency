class Solution {
public:
    string frequencySort(string s) {
        unordered_map<char, int> mp;
        vector<string> fr(s.size()+1, "");
        string res;

        for(char c : s) {
            mp[c]++;
        }
        for(auto &it : mp) {
            int n = it.second;
            char d = it.first;
            fr[n].append(n, d);
        }

        for(int i = s.size(); i>0; i--) {
            if(!fr[i].empty()) {
                res.append(fr[i]);
            }
        }
        return res;
    }
};
