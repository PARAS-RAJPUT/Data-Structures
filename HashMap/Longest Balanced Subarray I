class Solution {
public:
    int longestBalanced(vector<int>& nums) {
        int n = nums.size();
        int maxAns = 0;

        unordered_map<int, int>even, odd;
        for(int i = 0; i<n-1; i++) {
            even.clear();
            odd.clear();
            if(nums[i] % 2 == 0) {
                even[nums[i]] = 1;
            }
            else{
                odd[nums[i]] = 1;
            }

            for(int j = i+1; j<n; j++) {
                if(nums[j] % 2 == 0) {
                    even[nums[j]] = 1;
                }
                else{
                    odd[nums[j]] = 1;
                }

                if(even.size() == odd.size()) {
                    maxAns = max(maxAns, j-i+1);
                }
            }

        }
        return maxAns;
    }
};
