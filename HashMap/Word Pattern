class Solution {
public:
    bool wordPattern(string pattern, string s) {

        vector<string> v;
        string s_word;
        stringstream iss(s);
        while(iss >> s_word) {
            v.push_back(s_word);
        }
        if(pattern.size() != v.size()) {
            return false;
        }

        unordered_map<char, string> mp1;

        unordered_map<string, char>mp2;

        for(int i = 0; i<v.size(); i++) {
            if(mp1.find(pattern[i]) != mp1.end() && mp1[pattern[i]] != v[i]) {
                return false;
            }
            else if(mp2.find(v[i]) != mp2.end() && mp2[v[i]] != pattern[i]) {
                return false;
            }
            mp1[pattern[i]] = v[i];
            mp2[v[i]] = pattern[i];
        }

        return true;
        
    }
};
